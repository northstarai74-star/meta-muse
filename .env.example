# Supabase project settings: Project Settings > API (URL + keys) and Project Settings > Database (connection strings).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# The anon (or publishable) key. Safe for the browser: Row Level Security keeps the tables closed to it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only, never expose in the browser. Used to create and delete team logins and by `npm run db:seed`.
SUPABASE_SERVICE_ROLE_KEY=""

# Postgres (Supabase). DATABASE_URL is the pooled connection (port 6543) the app uses at runtime;
# DIRECT_URL is the direct connection (port 5432) that `prisma migrate` uses.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# 64 hex chars (32 bytes); encrypts API keys and Meta tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# First admin created by `npm run db:seed` in Supabase Auth. Use a real email you own.
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD=""

# Public base URL, used to display the webhook URL. On Vercel set https://your-app.vercel.app
APP_URL="http://localhost:3000"
