DATABASE_URL="file:./dev.db"
# Signs login sessions — use a long random string
SESSION_SECRET="change-me-to-a-long-random-string"
# 64 hex chars (32 bytes); encrypts API keys and Meta tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# First admin created by `npm run db:seed`
ADMIN_EMAIL="admin@northstarai.local"
ADMIN_PASSWORD="ChangeMe123!"
# Public https base URL when tunnelling (ngrok / cloudflared) — used to display the webhook URL
APP_URL="http://localhost:3000"
