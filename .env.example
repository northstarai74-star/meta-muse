# Postgres connection string. On Vercel: Storage → add Neon/Postgres, which sets this for you
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Signs login sessions — use a long random string
SESSION_SECRET="change-me-to-a-long-random-string"
# 64 hex chars (32 bytes); encrypts API keys and Meta tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# First admin: created automatically on the first Vercel build when the DB has no users
# (or by `npm run db:seed` locally, which also loads demo data)
ADMIN_EMAIL="admin@vanita.local"
ADMIN_PASSWORD="ChangeMe123!"
# Public https base URL when tunnelling (ngrok / cloudflared) — used to display the webhook URL
APP_URL="http://localhost:3000"
