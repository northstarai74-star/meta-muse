# Postgres connection string (Neon / Supabase / Vercel Postgres, or a local server).
# On Vercel use the direct (non-pooled) URL so `prisma migrate deploy` works at build time.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Signs login sessions — use a long random string
SESSION_SECRET="change-me-to-a-long-random-string"
# 64 hex chars (32 bytes); encrypts API keys and Meta tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# First admin created by `npm run db:seed`
ADMIN_EMAIL="admin@northstarai.local"
ADMIN_PASSWORD="ChangeMe123!"
# Public base URL, used to display the webhook URL. On Vercel set https://your-app.vercel.app
# (the login cookie is marked Secure only when this starts with https).
APP_URL="http://localhost:3000"
