# Postgres connection string (Neon / Supabase / Vercel Postgres / local)
DATABASE_URL="postgresql://vanita:vanita@localhost:5432/vanita"
# Signs login sessions — use a long random string
SESSION_SECRET="change-me-to-a-long-random-string"
# 64 hex chars (32 bytes); encrypts API keys and Meta tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# First admin created by `npm run db:seed`
ADMIN_EMAIL="admin@vanita.local"
ADMIN_PASSWORD="ChangeMe123!"
# Public https base URL when tunnelling (ngrok / cloudflared) — used to display the webhook URL
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Third-party API keys (leave blank until you have them).
# NOTE: the app does not read these yet. Today, keys are added in the UI under
# Integrations (stored encrypted in the database). These are the values to
# paste there, or to read from env once the integrations are wired in.
# ---------------------------------------------------------------------------

# Meta (Facebook app + Instagram) — developers.facebook.com
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
INSTAGRAM_BUSINESS_ID=""

# Higgsfield (AI video / image generation)
HIGGSFIELD_API_KEY=""

# AI voice agent provider (e.g. Vapi / Retell / ElevenLabs — set the one you use)
VOICE_AGENT_PROVIDER=""
VOICE_AGENT_API_KEY=""
VOICE_AGENT_ID=""

# OpenRouter
OPENROUTER_API_KEY=""

# Claude (Anthropic)
ANTHROPIC_API_KEY=""

# Brevo (email / SMS)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""
