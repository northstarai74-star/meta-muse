generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum-like string columns (kept as String for portability).
// ROLE: ADMIN | MEMBER
// SERVICE: AI_VOICE | WEB_DEV | DROPSHIPPING | UNASSIGNED
// STAGE: NEW | CONTACTED | QUALIFIED | PROPOSAL | WON | LOST
// SOURCE: META_DM | META_COMMENT | META_LEAD_AD | MANUAL
// AGENT: AI | HUMAN
// PROVIDER: META | CLAUDE | HIGGSFIELD
// KEY STATUS: ACTIVE | DISABLED | RATE_LIMITED

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("MEMBER")
  title        String?
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())

  leads      Lead[]
  activities Activity[]
  rules      AssignmentRule[]
  tasks      Task[]
}

model Contact {
  id              String   @id @default(cuid())
  name            String
  email           String?
  phone           String?
  instagramHandle String?
  igUserId        String?  @unique
  company         String?
  notes           String?
  source          String   @default("MANUAL")
  createdAt       DateTime @default(now())

  leads         Lead[]
  conversations Conversation[]
  comments      Comment[]
  clients       Client[]
}

model Lead {
  id              String   @id @default(cuid())
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title           String
  source          String   @default("MANUAL")
  service         String   @default("UNASSIGNED")
  stage           String   @default("NEW")
  score           Int      @default(0)
  aiSummary       String?
  assignedAgent   String   @default("HUMAN")
  assignedUserId  String?
  assignedUser    User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  estimatedValue  Float    @default(0)
  lostReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks       Task[]
  deals       Deal[]
  activities  Activity[]
  comments    Comment[]
  enquiries   Enquiry[]

  @@index([service])
  @@index([stage])
  @@index([createdAt])
}

model Deal {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service   String
  amount    Float
  status    String    @default("PAID") // PENDING | PAID
  paidAt    DateTime  @default(now())

  @@index([paidAt])
}

model Conversation {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  platform    String    @default("INSTAGRAM")
  externalId  String?   @unique
  unread      Int       @default(0)
  lastMessageAt DateTime @default(now())
  messages    Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String?      @unique
  direction      String       // IN | OUT
  text           String
  sentAt         DateTime     @default(now())

  @@index([conversationId, sentAt])
}

model Comment {
  id         String   @id @default(cuid())
  externalId String?  @unique
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  postRef    String?
  author     String
  text       String
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(cuid())
  externalId String? @unique
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  formName  String?
  name      String?
  email     String?
  phone     String?
  message   String?
  raw       String?  // JSON payload
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id             String    @id @default(cuid())
  provider       String
  label          String
  encryptedValue String
  keyHint        String    // last 4 chars for display
  status         String    @default("ACTIVE")
  priority       Int       @default(0)
  usageCount     Int       @default(0)
  lastUsedAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  @@index([provider, status])
}

model MetaConnection {
  id            String   @id @default("singleton")
  appId         String?
  appSecretEnc  String?
  pageId        String?
  igBusinessId  String?
  accessTokenEnc String?
  verifyToken   String
  connected     Boolean  @default(false)
  lastSyncAt    DateTime?
  updatedAt     DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   // CREATED | ASSIGNED | STAGE | NOTE | AI | CONVERTED
  text      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model AssignmentRule {
  id      String  @id @default(cuid())
  service String  @unique
  agent   String  @default("HUMAN") // AI | HUMAN
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Setting {
  key   String @id
  value String
}

/// Follow-up reminder attached to a lead.
model Task {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title          String
  dueAt          DateTime
  done           Boolean   @default(false)
  doneAt         DateTime?
  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([done, dueAt])
  @@index([leadId])
}

/// Saved quick reply for the Instagram inbox. `{{name}}` is replaced with the contact's first name.
model Template {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

// ---- Business sections: store, marketing, clients, finance ----
// STORE STATUS: ACTIVE | TESTING | PAUSED     ORDER STATUS: PENDING | SHIPPED | DELIVERED | REFUNDED
// CAMPAIGN STATUS: PLANNED | ACTIVE | PAUSED | DONE     CONTENT STATUS: IDEA | DRAFT | SCHEDULED | POSTED
// CLIENT STATUS: ACTIVE | PAUSED | CHURNED     ENTRY TYPE: INCOME | EXPENSE
// BUSINESS LINE: AI_VOICE | WEB_DEV | DROPSHIPPING | GENERAL

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String?
  supplier  String?
  cost      Float    @default(0)
  price     Float    @default(0)
  stock     Int      @default(0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  orders StoreOrder[]
}

model StoreOrder {
  id          String   @id @default(cuid())
  number      String
  customer    String
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int      @default(1)
  revenue     Float    @default(0)
  cost        Float    @default(0)
  status      String   @default("PENDING")
  placedAt    DateTime @default(now())

  @@index([placedAt])
}

model Campaign {
  id             String    @id @default(cuid())
  name           String
  channel        String    @default("INSTAGRAM")
  service        String    @default("ALL")
  status         String    @default("PLANNED")
  budget         Float     @default(0)
  spend          Float     @default(0)
  leadsGenerated Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
}

model ContentItem {
  id           String    @id @default(cuid())
  title        String
  channel      String    @default("INSTAGRAM")
  status       String    @default("IDEA")
  scheduledFor DateTime?
  caption      String?
  createdAt    DateTime  @default(now())
}

model Client {
  id         String    @id @default(cuid())
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service    String
  monthlyFee Float     @default(0)
  status     String    @default("ACTIVE")
  startedAt  DateTime  @default(now())
  renewsAt   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([status])
}

model FinanceEntry {
  id           String   @id @default(cuid())
  type         String
  category     String
  amount       Float
  businessLine String   @default("GENERAL")
  note         String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([occurredAt])
}

model Reserve {
  id        String        @id @default(cuid())
  name      String
  target    Float         @default(0)
  balance   Float         @default(0)
  createdAt DateTime      @default(now())
  moves     ReserveMove[]
}

model ReserveMove {
  id        String   @id @default(cuid())
  reserveId String
  reserve   Reserve  @relation(fields: [reserveId], references: [id], onDelete: Cascade)
  delta     Float
  note      String?
  createdAt DateTime @default(now())

  @@index([reserveId, createdAt])
}
